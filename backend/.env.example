# PostgreSQL connection — fill in your details
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/yourdbname

# Server port
PORT=3001

# Optional: restrict CORS to your frontend origin
CORS_ORIGIN=*

# Track history default window
TRACK_HOURS=6

# Optional: devices must send this as the x-api-key header when posting to /api/gps
GPS_API_KEY=

# Login account for the web app (CHANGE THESE before sharing or deploying)
APP_USER=admin
APP_PASSWORD=change-me
# Any long random text; if empty, everyone is logged out whenever the server restarts
APP_SECRET=

# ── Fleet rules (defaults match the proposal's status table) ──
IDLE_MIN=5               # minutes outside a work zone before a stop counts as idle
LOAD_MAX_MIN=10          # minutes in a pit/dump zone before it counts as queueing
OFFLINE_MIN=10           # no GPS for this long = offline
MIN_SATS=8               # fewer satellites = weak fix, ignored
STOP_MIN_S=60            # pauses shorter than this are not stops
STOP_RADIUS_M=30         # GPS drift inside this radius is ignored
STOP_DETECT_INTERVAL_S=20  # how often stops are rebuilt from GPS (0 = off)
IDLE_BURN_L_PER_H=8      # ASSUMED litres/hour while idling — confirm with the mine

# ── Shifts (two 12-hour shifts, India time) ──
SHIFT_START_HOUR=6
SHIFT_HOURS=12
SHIFT_TZ_OFFSET_MIN=330

# ── Machine-learning checks (ml/fleet_ml.py) ──
API_URL=http://localhost:3001/api   # the ML script signs in with APP_USER / APP_PASSWORD above
ML_MIN_TRIPS=30          # train the slow-trip model only with at least this many trips
ML_MIN_STOPS=50          # ...and the unusual-stop model with at least this many stops
ML_SLOW_SIGMA=3          # flag trips this many typical-errors slower than expected
ML_SLOW_MIN_EXTRA_MIN=3  # ...and at least this many minutes slower
ML_CONTAMINATION=0.05    # share of stops the Isolation Forest may call odd
